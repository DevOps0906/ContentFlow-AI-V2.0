# Copy to .env (never commit it). All values are read on the server only.

# --- AI draft generation (OpenAI-compatible Chat Completions) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- WordPress (drafts only). Use an Application Password, not the login password. ---
# https is required except for localhost.
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# --- Supabase (local stack from `npx supabase start`, ports in supabase/config.toml) ---
# Inside the web container the host is reached as host.docker.internal.
SUPABASE_URL=http://127.0.0.1:60321
SUPABASE_PUBLISHABLE_KEY=
