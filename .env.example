# Copy to .env (never commit it). All values are read on the server only.

# --- AI draft generation (OpenAI-compatible Chat Completions) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional review model; uses OPENAI_MODEL when omitted and shows a same-model notice.
# QA_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional unit prices per 1M tokens for the cost estimate in AI run logs (reference only, not
# billing). Without all three the cost shows N/A.
# AI_PRICE_INPUT_PER_1M=
# AI_PRICE_OUTPUT_PER_1M=
# AI_PRICE_CURRENCY=USD
# Needed only when QA_MODEL differs from OPENAI_MODEL; otherwise its cost shows N/A.
# QA_PRICE_INPUT_PER_1M=
# QA_PRICE_OUTPUT_PER_1M=

# --- WordPress (drafts only). Use an Application Password, not the login password. ---
# https is required except for localhost.
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# --- Supabase: enables login + database storage. Leave empty for browser-only local mode. ---
# Local stack: `npx supabase start` (ports in supabase/config.toml); keys are printed by `npx supabase status`.
# Inside the web container the host is reached as host.docker.internal.
SUPABASE_URL=http://127.0.0.1:60321
SUPABASE_PUBLISHABLE_KEY=
# Set to true when the app is served over https (marks the session cookie Secure).
COOKIE_SECURE=false
# Set to false to stop new accounts from being created.
ALLOW_SIGNUP=true
# Public app origin used in confirmation/reset links (set explicitly behind a proxy).
# APP_URL=https://contentflow.example.com
