# CLOUD Supabase (supabase.com project). Copy to .env.cloud (never commit).
# Use:  $env:ENV_FILE=".env.cloud"; docker compose up -d --build
# Only the publishable key belongs here. Never put the secret/service_role key or DB password in any app env file.
# The app requires https for SUPABASE_URL and APP_URL on non-local hosts.
# Docs: docs/08-ops/SUPABASE_ENVIRONMENTS.md

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<cloud-publishable-key>
COOKIE_SECURE=true
# Set false to stop new accounts from being created.
ALLOW_SIGNUP=true
APP_URL=https://<your-app-domain>

# --- AI draft generation (OpenAI-compatible Chat Completions) ---
# AI provider: gemini (default when GEMINI_API_KEY is set) or openai. Keys stay on the server.
# AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_QA_MODEL=
# AI_ALLOWED_MODELS=gemini-3.5-flash,gemini-2.5-flash  (선택: 화면에서 고를 수 있는 모델을 제한)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# QA_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_PRICE_INPUT_PER_1M=
# AI_PRICE_OUTPUT_PER_1M=
# AI_PRICE_CURRENCY=USD
# QA_PRICE_INPUT_PER_1M=
# QA_PRICE_OUTPUT_PER_1M=

# --- WordPress (drafts only). Application Password, not the login password. https required except localhost. ---
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# --- Mobile app (Capacitor) Bearer session, read-only. Comma-separated Origins allowed for CORS.
# Default: https://localhost,capacitor://localhost. Cloud refuses account mode if an http:// origin is listed.
# The access token stays valid until it expires (about 1 hour) even after /api/auth/token/revoke.
# MOBILE_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
# TRUST_PROXY=true   (리버스 프록시 뒤에서만: 토큰 IP 제한에 x-forwarded-for 가장 오른쪽 hop 사용. 기본 꺼짐 = 공용 direct 버킷)
