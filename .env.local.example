# LOCAL Supabase (Docker stack from `scripts/supabase-local.ps1 start`). Copy to .env.local (never commit).
# Use:  $env:ENV_FILE=".env.local"; docker compose up -d --build
# Keys: `npx supabase status` prints the publishable key. Never put the secret/service_role key here.
# Docs: docs/08-ops/SUPABASE_ENVIRONMENTS.md

# The web container reaches the host-side Supabase through host.docker.internal.
SUPABASE_URL=http://host.docker.internal:60321
SUPABASE_PUBLISHABLE_KEY=<local-publishable-key-from-supabase-status>
COOKIE_SECURE=false
ALLOW_SIGNUP=true
APP_URL=http://localhost:3410

# --- Naver homefeed reference titles (서버 전용, 브라우저로 보내지 않음) ---
# 네이버 검색 API(openapi.naver.com 블로그 검색). 비워 두면 화면에 '연결 안 됨'.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 네이버 검색광고 API 키워드 도구. 비즈머니 0인 전용 광고주 계정의 키를 쓰세요.
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=
# 계정 모드: 이 워크스페이스 ID에서만 네이버 블로그 검색·키워드 도구 사용(단일 소유자, 약관). 로컬 모드는 무시.
NAVER_OWNER_WORKSPACE_ID=

# --- Coupang Partners 상품 검색·딥링크 (서버 전용, 브라우저로 보내지 않음) ---
# 비워 두면 편집기 쿠팡 상품 패널이 '연결 안 됨'. 같은 키를 여러 환경에서 쓰지 마세요.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 1이어야 실제 호출(호출 제한 공식 확인 후 켬).
COUPANG_ENABLED=
# 계정 모드: 이 워크스페이스 ID에서만 동작(단일 소유자). 로컬 모드는 무시.
COUPANG_OWNER_WORKSPACE_ID=
# 채널 ID(영숫자만, 기본 contentflow).
COUPANG_SUB_ID=

# --- AI draft generation (OpenAI-compatible Chat Completions) ---
# AI provider: gemini (default when GEMINI_API_KEY is set) or openai. Keys stay on the server.
# AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_QA_MODEL=
# AI_ALLOWED_MODELS=gemini-3.5-flash,gemini-2.5-flash  (선택: 화면에서 고를 수 있는 모델을 제한)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# QA_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_PRICE_INPUT_PER_1M=
# AI_PRICE_OUTPUT_PER_1M=
# AI_PRICE_CURRENCY=USD
# QA_PRICE_INPUT_PER_1M=
# QA_PRICE_OUTPUT_PER_1M=

# --- WordPress (drafts only). Application Password, not the login password. https required except localhost. ---
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# --- Mobile app (Capacitor) Bearer session, read-only. Comma-separated Origins allowed for CORS.
# Default: https://localhost,capacitor://localhost. Cloud refuses account mode if an http:// origin is listed.
# The access token stays valid until it expires (about 1 hour) even after /api/auth/token/revoke.
# MOBILE_ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://10.0.2.2:3410
# TRUST_PROXY=true   (리버스 프록시 뒤에서만: 토큰 IP 제한에 x-forwarded-for 가장 오른쪽 hop 사용. 기본 꺼짐 = 공용 direct 버킷)
