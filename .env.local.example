# LOCAL Supabase (Docker stack from `scripts/supabase-local.ps1 start`). Copy to .env.local (never commit).
# Use:  $env:ENV_FILE=".env.local"; docker compose up -d --build
# Keys: `npx supabase status` prints the publishable key. Never put the secret/service_role key here.
# Docs: docs/08-ops/SUPABASE_ENVIRONMENTS.md

# The web container reaches the host-side Supabase through host.docker.internal.
SUPABASE_URL=http://host.docker.internal:60321
SUPABASE_PUBLISHABLE_KEY=<local-publishable-key-from-supabase-status>
COOKIE_SECURE=false
ALLOW_SIGNUP=true
APP_URL=http://localhost:3410

# --- AI draft generation (OpenAI-compatible Chat Completions) ---
# AI provider: gemini (default when GEMINI_API_KEY is set) or openai. Keys stay on the server.
# AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_QA_MODEL=
# AI_ALLOWED_MODELS=gemini-3.5-flash,gemini-2.5-flash  (선택: 화면에서 고를 수 있는 모델을 제한)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# QA_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_PRICE_INPUT_PER_1M=
# AI_PRICE_OUTPUT_PER_1M=
# AI_PRICE_CURRENCY=USD
# QA_PRICE_INPUT_PER_1M=
# QA_PRICE_OUTPUT_PER_1M=

# --- WordPress (drafts only). Application Password, not the login password. https required except localhost. ---
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=
